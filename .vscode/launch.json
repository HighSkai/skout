{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Skout",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/test-workspace"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Attach to Skout server",
      "type": "node",
      "request": "attach",
      "port": 6011,
      "restart": true,
      "outFiles": ["${workspaceFolder}/dist/**/*.js"]
    }
  ]
}
